# Copy this file to .env and fill in real values. Never commit .env.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL
DATABASE_NAME=securescan
DATABASE_USER=securescan_user
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Email — Gmail SMTP for verification and password reset.
# Create an App Password at https://myaccount.google.com/apppasswords
# (2-Step Verification must be on). Paste the 16-character password below.
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD empty to skip sending (DEBUG links only).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
FRONTEND_BASE_URL=http://127.0.0.1:5500
# Optional ports for python start.py / run_dev.py
DEV_API_PORT=8000
DEV_FRONTEND_PORT=5500

# Git provider credentials (used only transiently for private repo import,
# never logged, never stored in plaintext beyond an encrypted-at-rest field)
GIT_IMPORT_TIMEOUT_SECONDS=120

# Scanner configuration
SCAN_TEMP_DIR=scan_temp
MAX_UPLOAD_SIZE_MB=200
SCANNER_SUBPROCESS_TIMEOUT_SECONDS=300
ENABLE_SEMGREP=True
ENABLE_BANDIT=True
ENABLE_PIP_AUDIT=True
ENABLE_CHECKOV=True
ENABLE_GITLEAKS=True
ENABLE_TRIVY=True
